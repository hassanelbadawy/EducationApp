<div class="page-container">

    <div class="app-card">

        <h2 class="page-title">
            Dashboard
        </h2>

        <p class="page-subtitle">

            Welcome

            <strong>
                @ViewBag.FullName
            </strong>
        </p>
        <p>

            Role:
            <strong>
                @ViewBag.Role
            </strong>
            @if (ViewBag.Role == "Admin")
            {
                <a asp-controller="Admin"
                   asp-action="Users"
                   class="btn btn-primary">
                    User Management
                </a>
            }
        </p>

        <hr />

        <a asp-controller="Account"
           asp-action="Logout"
           class="btn btn-danger">
            Logout
        </a>

    </div>

</div>