@model EducationApp.Models.User

<div class="page-container">

    <div class="app-card">

        <h2 class="page-title">
            Edit User
        </h2>

        <form method="post">

            <input asp-for="UserId"
                   type="hidden" />

            <label>Full Name</label>

            <input asp-for="FullName"
                   class="form-control" />

            <label>Email</label>

            <input asp-for="Email"
                   class="form-control" />

            <br />

            <button type="submit"
                    class="btn-primary-custom">

                Save Changes

            </button>

        </form>

    </div>

</div>