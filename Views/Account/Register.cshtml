@model EducationApp.Models.RegisterViewModel

<div class="page-container">

    <div class="app-card">

        <h2 class="page-title">
            Create Account
        </h2>

        <p class="page-subtitle">
            Join EducationApp Today
        </p>

        <form method="post">

            <label>Full Name</label>

            <input asp-for="FullName"
                   class="form-control" />

            <label>Email</label>

            <input asp-for="Email"
                   class="form-control" />

            <label>Password</label>

            <input asp-for="Password"
                   type="password"
                   class="form-control" />

            <button type="submit"
                    class="btn-primary-custom">
                Register
            </button>

        </form>

    </div>

</div>