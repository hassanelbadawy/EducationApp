@model EducationApp.Models.RegisterViewModel

<h2>Register</h2>

<form method="post">

    <div>
        <label>Full Name</label>
        <input asp-for="FullName" />
    </div>

    <br />

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <br />

    <button type="submit">
        Register
    </button>

</form>